<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="co.edu.sena.sgac.model.Estudiante" %><%Estudiante e=(Estudiante)request.getAttribute("estudiante");boolean editar=e!=null&&e.getId()>0;String ctx=request.getContextPath();String error=(String)request.getAttribute("error");%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=editar?"Editar":"Registrar"%> estudiante | SGA</title><link rel="stylesheet" href="<%=ctx%>/css/estilos.css"></head><body><header class="topbar"><div class="logo">SGA</div><div><b>Sistema de Gestión Académica</b><small>Administración académica</small></div></header><main class="container narrow"><a class="back" href="<%=ctx%>/estudiantes">← Volver al listado</a><section class="card formcard"><p class="eyebrow"><%=editar?"ACTUALIZACIÓN":"NUEVO REGISTRO"%></p><h1><%=editar?"Editar estudiante":"Registrar estudiante"%></h1><p class="muted">Complete la información solicitada.</p><%if(error!=null){%><div class="error"><%=error%></div><%}%>
<form class="studentform" method="post" action="<%=ctx%>/estudiantes"><input type="hidden" name="accion" value="<%=editar?"actualizar":"guardar"%>"><%if(editar){%><input type="hidden" name="id" value="<%=e.getId()%>"><%}%>
<label>Documento<input name="documento" maxlength="20" required value="<%=val(e==null?null:e.getDocumento())%>"></label><div class="grid"><label>Nombres<input name="nombres" maxlength="80" required value="<%=val(e==null?null:e.getNombres())%>"></label><label>Apellidos<input name="apellidos" maxlength="80" required value="<%=val(e==null?null:e.getApellidos())%>"></label></div><label>Correo electrónico<input type="email" name="correo" maxlength="120" required value="<%=val(e==null?null:e.getCorreo())%>"></label><label>Programa académico<input name="programa" maxlength="100" required value="<%=val(e==null?null:e.getPrograma())%>"></label><div class="formactions"><a class="btn secondary" href="<%=ctx%>/estudiantes">Cancelar</a><button class="btn primary" type="submit"><%=editar?"Guardar cambios":"Registrar estudiante"%></button></div></form></section></main></body></html><%!private String val(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}%>
