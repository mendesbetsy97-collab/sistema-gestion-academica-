<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.List,co.edu.sena.sgac.model.Estudiante" %><% List<Estudiante> lista=(List<Estudiante>)request.getAttribute("estudiantes"); String msg=request.getParameter("mensaje"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Estudiantes | SGA</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body>
<header class="topbar"><div class="logo">SGA</div><div><b>Sistema de Gestión Académica</b><small>Administración académica</small></div></header><main class="container"><section class="intro"><div><p class="eyebrow">MÓDULO ACADÉMICO</p><h1>Estudiantes</h1><p class="muted">Consulte y administre los registros de estudiantes.</p></div><a class="btn primary" href="<%=request.getContextPath()%>/estudiantes?accion=nuevo">＋ Nuevo estudiante</a></section>
<%if("creado".equals(msg)){%><div class="notice">Estudiante registrado correctamente.</div><%}if("actualizado".equals(msg)){%><div class="notice">Datos actualizados correctamente.</div><%}if("eliminado".equals(msg)){%><div class="notice">Estudiante eliminado correctamente.</div><%}%>
<section class="card"><div class="cardhead"><div><h2>Listado de estudiantes</h2><p class="muted">Datos almacenados en MySQL mediante JDBC.</p></div><span class="pill"><%=lista.size()%> registros</span></div><div class="tablewrap"><table><thead><tr><th>ID</th><th>Documento</th><th>Nombre completo</th><th>Correo</th><th>Programa</th><th>Acciones</th></tr></thead><tbody>
<%if(lista.isEmpty()){%><tr><td colspan="6" class="empty">No hay registros todavía. Cree el primer estudiante con el botón superior.</td></tr><%}for(Estudiante e:lista){%><tr><td><%=e.getId()%></td><td><%=esc(e.getDocumento())%></td><td><strong><%=esc(e.getNombres())%> <%=esc(e.getApellidos())%></strong></td><td><%=esc(e.getCorreo())%></td><td><%=esc(e.getPrograma())%></td><td class="actions"><a class="btn small secondary" href="<%=request.getContextPath()%>/estudiantes?accion=editar&id=<%=e.getId()%>">Editar</a><form method="post" action="<%=request.getContextPath()%>/estudiantes" onsubmit="return confirm('¿Desea eliminar este registro?')"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%=e.getId()%>"><button class="btn small danger">Eliminar</button></form></td></tr><%}%>
</tbody></table></div></section><p class="footer">Proyecto académico · Java · Servlets · JDBC · MySQL</p></main></body></html><%!private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#x27;");}%>
